---
/** Diagramas de U5.3 Búsqueda: lineal paralela, DFS, branch and bound (PLE), IDA*, p = b^k, PWS/DTS/clusters, balance de carga y tareas untied. */
import '../styles/svgfig.css';
type Fig = 'lineal' | 'dfs' | 'ple' | 'ida' | 'pbk' | 'pwsdts' | 'balance' | 'untied';
interface Props {
	fig: Fig;
}
const { fig } = Astro.props;
const A = `url(#bqa-${fig})`;
const R = `url(#bqr-${fig})`;
const defs = `<defs><marker id="bqa-${fig}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head"/></marker><marker id="bqr-${fig}" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0L10 5L0 10z" class="head-bad"/></marker></defs>`;
const pc = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'];

const vec = [4, 9, 1, 7, 12, 3, 8, 5, 11, 2, 15, 6, 10, 14, 0, 13];
const X = 11;

const t2 = (ox: number, oy: number, dx: number) => {
	const n = [
		{ x: ox, y: oy },
		{ x: ox - dx, y: oy + 62 },
		{ x: ox + dx, y: oy + 62 },
		{ x: ox - dx * 1.5, y: oy + 124 },
		{ x: ox - dx * 0.5, y: oy + 124 },
		{ x: ox + dx * 0.5, y: oy + 124 },
		{ x: ox + dx * 1.5, y: oy + 124 },
	];
	const e = [[0, 1], [0, 2], [1, 3], [1, 4], [2, 5], [2, 6]];
	return { n, e };
};
const dfsL = t2(190, 40, 80);
const dfsR = t2(570, 40, 80);
const ordenDfs = [1, 2, 5, 3, 4, 6, 7];

type P = { k: string; x: number; y: number; p?: number; e: string; st: 'ok' | 'gris' | 'meta' | 'poda' };
const ple: P[] = [
	{ k: 'r', x: 420, y: 34, e: '', st: 'ok' },
	{ k: 'a', x: 290, y: 98, p: 0, e: 'x₁=0', st: 'gris' },
	{ k: 'b', x: 560, y: 98, p: 0, e: 'x₁=1', st: 'ok' },
	{ k: 'c', x: 470, y: 162, p: 2, e: 'x₂=0', st: 'ok' },
	{ k: 'd', x: 660, y: 162, p: 2, e: 'x₂=1', st: 'poda' },
	{ k: 'e', x: 410, y: 226, p: 3, e: 'x₃=0', st: 'gris' },
	{ k: 'f', x: 505, y: 226, p: 3, e: 'x₃=1', st: 'ok' },
	{ k: 'g', x: 460, y: 290, p: 6, e: 'x₄=0', st: 'gris' },
	{ k: 'h', x: 545, y: 290, p: 6, e: 'x₄=1', st: 'meta' },
	{ k: 'i', x: 625, y: 226, p: 4, e: 'x₃=0', st: 'ok' },
	{ k: 'j', x: 740, y: 226, p: 4, e: 'x₃=1', st: 'gris' },
	{ k: 'k', x: 605, y: 290, p: 9, e: 'x₄=0', st: 'gris' },
	{ k: 'l', x: 690, y: 290, p: 9, e: 'x₄=1', st: 'meta' },
];

const ida = [1, 2, 3].map((lim, i) => ({ lim, ox: 130 + i * 250 }));
const idaT = (ox: number) => {
	const n: { x: number; y: number; d: number }[] = [];
	const e: [number, number][] = [];
	const add = (x: number, y: number, d: number, p: number) => {
		n.push({ x, y, d });
		if (p >= 0) e.push([p, n.length - 1]);
		return n.length - 1;
	};
	const go = (x: number, d: number, p: number, w: number) => {
		const me = add(x, 50 + d * 52, d, p);
		if (d < 3) {
			go(x - w, d + 1, me, w / 2);
			go(x + w, d + 1, me, w / 2);
		}
	};
	go(ox, 0, -1, 56);
	return { n, e };
};

const bal = [
	{ t: 'Round robin asíncrono (ARR)', ox: 20, f: 'T_comm = O(p² log W)', nota: 'cada uno con su contador: muchas llamadas' },
	{ t: 'Round robin global (GRR)', ox: 270, f: 'T_comm = O(p log W)', nota: 'pocas llamadas, pero un cuello de botella' },
	{ t: 'Polling aleatorio (RP)', ox: 520, f: 'T_comm = O(p log p log W)', nota: 'intermedio y sin cuello de botella' },
];
---

<figure class="svgfig not-content">
	<div class="svgfig__scroll">
		{fig === 'lineal' && (
			<svg viewBox="0 0 760 230" role="img" aria-label="Búsqueda lineal paralela: el vector se reparte en 4 bloques y los resultados se combinan con un OR en árbol">
				<Fragment set:html={defs} />
				<text x="20" y="22" class="t s l mu">A (n = 16), buscar x = {X}, p = 4 procesos</text>
				{vec.map((v, i) => (
					<>
						<rect x={20 + i * 34} y="32" width="30" height="30" rx="4" class={v === X ? 'c4' : pc[Math.floor(i / 4)]} />
						<text x={35 + i * 34} y="52" class={v === X ? 't s b' : 't s'}>{v}</text>
					</>
				))}
				{[0, 1, 2, 3].map((b) => (
					<>
						<text x={20 + b * 136 + 64} y="80" class="t s b">P{b}: n/p = 4</text>
						<rect x={20 + b * 136 + 14} y="92" width="100" height="28" rx="6" class={b === 2 ? 'c4' : 'box'} />
						<text x={20 + b * 136 + 64} y="111" class="t s mono">enc = {b === 2 ? 1 : 0}</text>
					</>
				))}
				<line x1="84" y1="120" x2="140" y2="150" class="ln" marker-end={A} />
				<line x1="220" y1="120" x2="160" y2="150" class="ln" marker-end={A} />
				<line x1="356" y1="120" x2="412" y2="150" class="ln" marker-end={A} />
				<line x1="492" y1="120" x2="432" y2="150" class="ln" marker-end={A} />
				<rect x="110" y="152" width="80" height="26" rx="6" class="box" />
				<text x="150" y="170" class="t s mono">OR = 0</text>
				<rect x="382" y="152" width="80" height="26" rx="6" class="c4" />
				<text x="422" y="170" class="t s mono">OR = 1</text>
				<line x1="150" y1="178" x2="270" y2="196" class="ln" marker-end={A} />
				<line x1="422" y1="178" x2="300" y2="196" class="ln" marker-end={A} />
				<rect x="236" y="196" width="100" height="28" rx="6" class="c4" />
				<text x="286" y="215" class="t s b">¡está!</text>
				<text x="560" y="110" class="t s l">1) cada proceso mira</text>
				<text x="560" y="128" class="t s l">   sus n/p elementos: O(n/p)</text>
				<text x="560" y="160" class="t s l">2) REDUCE_OR en árbol:</text>
				<text x="560" y="178" class="t s l">   log p niveles: O(log p)</text>
				<text x="560" y="212" class="t s l b">T_p = O(n/p + log p)</text>
			</svg>
		)}

		{fig === 'dfs' && (
			<svg viewBox="0 0 760 250" role="img" aria-label="DFS secuencial con orden de visita y DFS paralelo con una tarea por subárbol">
				<Fragment set:html={defs} />
				<text x="190" y="20" class="cap">secuencial: un nodo a la vez</text>
				<text x="570" y="20" class="cap">paralelo: una tarea por hijo</text>
				{dfsL.e.map(([a, b]) => <line x1={dfsL.n[a].x} y1={dfsL.n[a].y} x2={dfsL.n[b].x} y2={dfsL.n[b].y} class="ln" />)}
				{dfsL.n.map((q, i) => (
					<>
						<circle cx={q.x} cy={q.y} r="16" class="box" />
						<text x={q.x} y={q.y + 5} class="t b">{ordenDfs[i]}</text>
					</>
				))}
				<path d="M 172 158 Q 182 126 132 106" class="ln dash" marker-end={A} />
				<text x="214" y="140" class="t s mu">backtrack</text>
				<text x="190" y="232" class="t s mu">el número es el orden de visita · memoria O(d)</text>
				<rect x={dfsR.n[1].x - 70} y={dfsR.n[1].y - 26} width="140" height="140" rx="12" class="c1" opacity="0.55" />
				<rect x={dfsR.n[2].x - 70} y={dfsR.n[2].y - 26} width="140" height="140" rx="12" class="c2" opacity="0.55" />
				{dfsR.e.map(([a, b]) => <line x1={dfsR.n[a].x} y1={dfsR.n[a].y} x2={dfsR.n[b].x} y2={dfsR.n[b].y} class="ln" />)}
				{dfsR.n.map((q) => <circle cx={q.x} cy={q.y} r="14" class="box" />)}
				<text x={dfsR.n[1].x} y={dfsR.n[1].y + 5} class="t s b">task</text>
				<text x={dfsR.n[2].x} y={dfsR.n[2].y + 5} class="t s b">task</text>
				<text x={dfsR.n[0].x + 26} y={dfsR.n[0].y + 4} class="t s l">taskwait (SYNC)</text>
				<text x="570" y="232" class="t s mu">T∞ = O(h): la rama más larga · W = O(n)</text>
			</svg>
		)}

		{fig === 'ple' && (
			<svg viewBox="0 0 800 470" role="img" aria-label="Árbol de branch and bound del ejemplo de programación lineal entera">
				<Fragment set:html={defs} />
				<text x="400" y="18" class="t s b">min f(x) = 2x₁ + x₂ − x₃ − 2x₄,  x ∈ {'{'}0,1{'}'}⁴,  Ax ≥ b</text>
				<rect x={583} y={140} width={197} height={185} rx="12" class="trap" opacity="0.6" />
				<text x="681" y="345" class="t s bad b">↑ podado por costo (B&B)</text>
				{ple.filter((q) => q.p !== undefined).map((q) => {
					const pa = ple[q.p!];
					return (
						<>
							<line x1={pa.x} y1={pa.y} x2={q.x} y2={q.y} class="ln" />
							<text x={(pa.x + q.x) / 2 + (q.x < pa.x ? -8 : 8)} y={(pa.y + q.y) / 2 - 2} class={q.x < pa.x ? 't s r' : 't s l'}>{q.e}</text>
						</>
					);
				})}
				{ple.map((q) => (
					<circle cx={q.x} cy={q.y} r="11" class={q.st === 'meta' ? 'c4' : q.st === 'gris' ? 'trap' : 'box'} />
				))}
				<text x="545" y="314" class="t s b ok">f = −1 (óptimo)</text>
				<text x="700" y="314" class="t s">f = 1</text>
				<line x1="20" x2="780" y1="362" y2="362" class="sep" />
				<text x="20" y="384" class="t s l b">Poda por factibilidad (círculos rojos)</text>
				<text x="20" y="404" class="t s l mono">Σ fijas A·x + Σ libres máx(A, 0) &lt; b_i</text>
				<text x="20" y="424" class="t s l mu">ni poniendo a 1 lo que ayuda se llega a b_i</text>
				<text x="420" y="384" class="t s l b">Poda por costo (recuadro)</text>
				<text x="420" y="404" class="t s l mono">cota = Σ fijas c·x + Σ libres mín(c, 0)</text>
				<text x="420" y="424" class="t s l mu">x = (1,1,·,·): cota = 2 + 1 − 1 − 2 = 0 ≥ −1 → no mejora</text>
				<text x="400" y="458" class="t s b">solo factibilidad: 13 nodos visitados · con cota de costo: 9 (de 31 del árbol completo)</text>
			</svg>
		)}

		{fig === 'ida' && (
			<svg viewBox="0 0 760 250" role="img" aria-label="Profundización iterativa: tres rondas con límite de profundidad 1, 2 y 3">
				{ida.map((r) => {
					const tr = idaT(r.ox);
					const vis = tr.n.filter((q) => q.d <= r.lim).length;
					return (
						<>
							<text x={r.ox} y="22" class="cap">ronda {r.lim}: límite = {r.lim}</text>
							<line x1={r.ox - 115} x2={r.ox + 115} y1={50 + r.lim * 52 + 20} y2={50 + r.lim * 52 + 20} class="ln bad dash" />
							{tr.e.map(([a, b]) => <line x1={tr.n[a].x} y1={tr.n[a].y} x2={tr.n[b].x} y2={tr.n[b].y} class="ln" opacity={tr.n[b].d <= r.lim ? 1 : 0.25} />)}
							{tr.n.map((q, i) => (
								<circle cx={q.x} cy={q.y} r="8" class={i === 14 && r.lim === 3 ? 'c4' : q.d <= r.lim ? pc[r.lim - 1] : 'box'} opacity={q.d <= r.lim ? 1 : 0.3} />
							))}
							<text x={r.ox} y="242" class="t s">{vis} nodos visitados</text>
						</>
					);
				})}
			</svg>
		)}

		{fig === 'pbk' && (
			<svg viewBox="0 0 760 260" role="img" aria-label="Partición del árbol en el nivel k con p = b elevado a k procesos, y caso no balanceado">
				<text x="190" y="20" class="cap">balanceado: b = 2, k = 2 → p = 4</text>
				<polygon points="190,36 120,106 260,106" class="box" />
				<text x="190" y="84" class="t s">secuencial</text>
				<text x="190" y="100" class="t s mu">O(b^k)</text>
				<line x1="20" x2="360" y1="106" y2="106" class="ln bad dash" />
				<text x="362" y="102" class="t s l bad">k</text>
				{[0, 1, 2, 3].map((i) => (
					<>
						<polygon points={`${55 + i * 90},106 ${15 + i * 90},226 ${95 + i * 90},226`} class={pc[i]} />
						<text x={55 + i * 90} y="196" class="t s b">P{i}</text>
					</>
				))}
				<text x="190" y="250" class="t s">T_p = O(b^k + b^(d−k))</text>
				<text x="570" y="20" class="cap">no balanceado: cortar más profundo</text>
				<polygon points="570,36 500,96 640,96" class="box" />
				<line x1="400" x2="745" y1="96" y2="96" class="ln bad dash" />
				{[
					[420, 30, 0], [462, 70, 1], [504, 18, 2], [546, 54, 3], [588, 26, 0], [630, 90, 1], [672, 22, 2], [714, 40, 3],
				].map(([x, h, p]) => (
					<polygon points={`${x},96 ${x - 18},${96 + h * 1.3} ${x + 18},${96 + h * 1.3}`} class={pc[p]} />
				))}
				<text x="570" y="232" class="t s">muchos subárboles por proceso (P0..P3 se turnan):</text>
				<text x="570" y="250" class="t s">los grandes y los chicos se compensan</text>
			</svg>
		)}

		{fig === 'pwsdts' && (
			<svg viewBox="0 0 760 270" role="img" aria-label="Comparación de parallel window search, distributed tree search y clusters">
				<text x="125" y="20" class="cap">PWS (Powley y Korf)</text>
				<text x="380" y="20" class="cap">DTS (Kumar y Rao)</text>
				<text x="635" y="20" class="cap">clusters (Cook)</text>
				{[0, 1, 2].map((i) => (
					<>
						<polygon points={`${55 + i * 70},40 ${25 + i * 70},180 ${85 + i * 70},180`} class="box" />
						<polygon points={`${55 + i * 70},40 ${55 + i * 70 - 30 * (0.35 + i * 0.3)},${40 + 140 * (0.35 + i * 0.3)} ${55 + i * 70 + 30 * (0.35 + i * 0.3)},${40 + 140 * (0.35 + i * 0.3)}`} class={pc[i]} />
						<text x={55 + i * 70} y="198" class="t s b">P{i}</text>
						<text x={55 + i * 70} y="214" class="t s mu">B + {i}Δ</text>
					</>
				))}
				<text x="125" y="240" class="t s">copia completa, umbral distinto</text>
				<text x="125" y="258" class="t s mu">bueno si la meta es profunda</text>
				<polygon points="380,40 300,180 460,180" class="box" />
				<polygon points="380,40 300,180 353,180" class="c1" />
				<polygon points="380,40 353,180 407,180" class="c2" />
				<polygon points="380,40 407,180 460,180" class="c3" />
				<line x1="290" x2="470" y1="150" y2="150" class="ln bad dash" />
				<text x="472" y="146" class="t s l bad">B</text>
				<text x="380" y="198" class="t s b">P0 · P1 · P2</text>
				<text x="380" y="240" class="t s">un subárbol cada uno, mismo umbral</text>
				<text x="380" y="258" class="t s mu">bueno si el árbol está balanceado</text>
				{[0, 1].map((c) => (
					<>
						<polygon points={`${595 + c * 85},40 ${560 + c * 85},180 ${630 + c * 85},180`} class="box" />
						{[0, 1, 2].map((j) => (
							<polygon points={`${595 + c * 85},40 ${560 + c * 85 + j * 23.3},180 ${560 + c * 85 + (j + 1) * 23.3},180`} class={pc[c * 3 + j]} opacity={0.85} />
						))}
						<line x1={555 + c * 85} x2={635 + c * 85} y1={c ? 110 : 150} y2={c ? 110 : 150} class="ln bad dash" />
						<text x={595 + c * 85} y="198" class="t s b">cluster {c + 1}</text>
						<text x={595 + c * 85} y="214" class="t s mu">umbral {c ? 'B' : 'B + Δ'}</text>
					</>
				))}
				<text x="635" y="240" class="t s">PWS entre clusters, DTS dentro</text>
				<text x="635" y="258" class="t s mu">1 cluster = DTS · p clusters = PWS</text>
			</svg>
		)}

		{fig === 'balance' && (
			<svg viewBox="0 0 760 250" role="img" aria-label="Tres esquemas de pedir trabajo: round robin asíncrono, global y polling aleatorio">
				<Fragment set:html={defs} />
				{bal.map((b, bi) => (
					<>
						<text x={b.ox + 110} y="20" class="cap">{b.t}</text>
						{[0, 1, 2, 3].map((i) => (
							<>
								<circle cx={b.ox + 30 + i * 55} cy="150" r="18" class={i === 3 ? 'c4' : 'box'} />
								<text x={b.ox + 30 + i * 55} y="155" class="t s b">P{i}</text>
							</>
						))}
						<text x={b.ox + 195} y="186" class="t s ok">tiene trabajo</text>
						{bi === 0 && (
							<>
								{[0, 1, 2].map((i) => <text x={b.ox + 30 + i * 55} y="118" class="t s mono">c={(i + 1) % 4}</text>)}
								<path d={`M ${b.ox + 30} 132 Q ${b.ox + 57} 100 ${b.ox + 80} 134`} class="ln" marker-end={A} />
								<path d={`M ${b.ox + 85} 132 Q ${b.ox + 112} 100 ${b.ox + 135} 134`} class="ln" marker-end={A} />
								<path d={`M ${b.ox + 140} 132 Q ${b.ox + 165} 100 ${b.ox + 189} 134`} class="ln" marker-end={A} />
								<text x={b.ox + 110} y="70" class="t s mu">cada uno avanza su contador:</text>
								<text x={b.ox + 110} y="86" class="t s mu">puede preguntar a ociosos</text>
							</>
						)}
						{bi === 1 && (
							<>
								<rect x={b.ox + 70} y="44" width="100" height="30" rx="6" class="trap" />
								<text x={b.ox + 120} y="64" class="t s b">contador global</text>
								{[0, 1, 2].map((i) => <line x1={b.ox + 30 + i * 55} y1="132" x2={b.ox + 110 + (i - 1) * 14} y2="76" class="ln bad" marker-end={R} />)}
								<text x={b.ox + 220} y="98" class="t s r bad">todos</text>
								<text x={b.ox + 220} y="112" class="t s r bad">consultan</text>
							</>
						)}
						{bi === 2 && (
							<>
								<path d={`M ${b.ox + 30} 132 Q ${b.ox + 110} 70 ${b.ox + 189} 134`} class="ln" marker-end={A} />
								<path d={`M ${b.ox + 85} 132 Q ${b.ox + 57} 96 ${b.ox + 34} 132`} class="ln dash" marker-end={A} />
								<path d={`M ${b.ox + 140} 132 Q ${b.ox + 165} 100 ${b.ox + 189} 134`} class="ln" marker-end={A} />
								<text x={b.ox + 110} y="56" class="t s mu">cada uno elige a quién</text>
								<text x={b.ox + 110} y="72" class="t s mu">pedir al azar</text>
							</>
						)}
						<text x={b.ox + 110} y="216" class="t s mono b">{b.f}</text>
						<text x={b.ox + 110} y="236" class="t s mu">{b.nota}</text>
					</>
				))}
			</svg>
		)}

		{fig === 'untied' && (
			<svg viewBox="0 0 760 200" role="img" aria-label="Una tarea untied empieza en el hilo 0, cede con taskyield y continúa en el hilo 1">
				<Fragment set:html={defs} />
				<text x="90" y="62" class="t s r">hilo 0</text>
				<text x="90" y="122" class="t s r">hilo 1</text>
				<line x1="100" y1="58" x2="740" y2="58" class="sep" />
				<line x1="100" y1="118" x2="740" y2="118" class="sep" />
				<rect x="110" y="42" width="170" height="30" rx="5" class="c1" />
				<text x="195" y="62" class="t s b">tarea T: f1()</text>
				<line x1="282" y1="34" x2="282" y2="140" class="ln bad dash" />
				<text x="282" y="28" class="t s bad b">taskyield</text>
				<rect x="290" y="42" width="190" height="30" rx="5" class="c2" />
				<text x="385" y="62" class="t s">otra tarea más urgente</text>
				<rect x="110" y="102" width="170" height="30" rx="5" class="c3" />
				<text x="195" y="122" class="t s">otra tarea</text>
				<rect x="300" y="102" width="170" height="30" rx="5" class="c1" />
