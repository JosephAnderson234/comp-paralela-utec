---
import '../styles/svgfig.css';
type Fig = 'umbral' | 'cubo';
interface Props { fig: Fig }
const { fig } = Astro.props;
const lv = [1, 3, 9];
const X = (l: number, i: number) => 380 + (i - (lv[l] - 1) / 2) * (l === 0 ? 0 : l === 1 ? 230 : 78);
const pc = ['c1', 'c2', 'c3', 'c4', 'c5', 'c6'];
---
<figure class="svgfig not-content">
  <div class="svgfig__scroll">
    {fig === 'umbral' && <svg viewBox="0 0 760 310" role="img" aria-label="Árbol ternario cortado en el nivel m igual a 2: arriba se crean tareas, abajo cada tarea recorre su subárbol">
      {[1, 2].flatMap((l) => Array.from({ length: lv[l] }, (_, i) => <line x1={X(l - 1, Math.floor(i / 3))} y1={40 + (l - 1) * 70} x2={X(l, i)} y2={40 + l * 70} class="ln" />))}
      {Array.from({ length: 9 }, (_, i) => <path d={`M ${X(2, i)} 190 L ${X(2, i) - 30} 236 L ${X(2, i) + 30} 236 Z`} class={pc[i % 6]} />)}
      {[0, 1, 2].flatMap((l) => Array.from({ length: lv[l] }, (_, i) => { const id = l === 0 ? 0 : l === 1 ? i + 1 : i + 4; return <><circle cx={X(l, i)} cy={40 + l * 70} r="15" class={l < 2 ? 'box' : pc[i % 6]} /><text x={X(l, i)} y={45 + l * 70} class="t s b">{id}</text></>; }))}
      <line x1="20" y1="160" x2="740" y2="160" class="ln dash" />
      <text x="24" y="44" class="t s l mu">nivel 0 · costo 2⁰</text>
      <text x="24" y="114" class="t s l mu">nivel 1 · costo 2¹</text>
      <text x="380" y="262" class="t s">arriba de la línea (ℓ &lt; m): se crean tareas con #pragma omp task</text>
      <text x="380" y="280" class="t s">en ℓ = m = 2: cada nodo es la raíz de una tarea</text>
      <text x="380" y="300" class="t s mu">cada triángulo = un subárbol que una tarea recorre con DFS secuencial · b<tspan class="mono">ᵐ</tspan> = 9 tareas para p hilos</text>
    </svg>}
    {fig === 'cubo' && <svg viewBox="0 0 760 240" role="img" aria-label="Dominio n por n por n dividido en p subcubos; cada subcubo intercambia sus seis caras">
      {[0, 1].flatMap((z) => [0, 1].flatMap((y) => [0, 1].map((x) => { const ox = 60 + x * 80 + z * 40, oy = 60 + y * 80 - z * 40; return <rect x={ox} y={oy} width="76" height="76" rx="4" class={x === 0 && y === 0 && z === 1 ? 'c2' : 'box'} opacity={z === 0 ? 0.55 : 1} />; })))}
      <text x="160" y="232" class="t s">dominio n×n×n en p = 8 subcubos (2×2×2)</text>
      <rect x="420" y="70" width="110" height="110" rx="6" class="c2" />
      <text x="475" y="120" class="t s b">subcubo</text><text x="475" y="140" class="t s mono">lado n/p^(1/3)</text>
      <text x="475" y="60" class="t s">cara ↑</text><text x="475" y="198" class="t s">cara ↓</text>
      <text x="405" y="128" class="t s r">←</text><text x="545" y="128" class="t s l">→</text>
      <text x="560" y="84" class="t s l b">por iteración</text>
      <text x="560" y="108" class="t s l">6 caras × (n/p^(1/3))²</text>
      <text x="560" y="128" class="t s l">= 6n²/p^(2/3) datos</text>
      <text x="560" y="160" class="t s l">+ sincronización global</text>
      <text x="560" y="180" class="t s l">en árbol: 12 log₂ p</text>
    </svg>}
  </div>
  <figcaption><slot /></figcaption>
</figure>
